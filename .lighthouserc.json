{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost:4173/index.html",
        "http://localhost:4173/programas.html",
        "http://localhost:4173/noticias.html",
        "http://localhost:4173/equipo.html",
        "http://localhost:4173/galeria.html",
        "http://localhost:4173/artistas.html",
        "http://localhost:4173/radio-online.html",
        "http://localhost:4173/contacto.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": "off",
        "categories:accessibility": "off",
        "categories:seo": "off",
        "categories:best-practices": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./informes-auditoria/lighthouse"
    }
  }
}
